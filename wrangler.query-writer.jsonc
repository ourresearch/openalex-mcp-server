{
  // openalex-query-writer (oxjob #1494): plain words to OQL behind api.openalex.org/query/text.
  // No route and no workers.dev URL: only the API proxy reaches it, over its QUERY_WRITER service binding, so every
  // call is held and settled against the caller's credits there.
  // Deploy: npx wrangler deploy -c wrangler.query-writer.jsonc
  // Secrets: npx wrangler secret put ANTHROPIC_API_KEY -c wrangler.query-writer.jsonc (and TYPESAFE_API_KEY, for confidence)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openalex-query-writer",
  "account_id": "a452eddbbe06eb7d02f4879cee70d29c",
  "main": "src/queryWriter.ts",
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public: the agent's calls to api.openalex.org must go through the public route (the API
  // proxy), so they run and are charged to the caller's key like any call; without it a same-account fetch can go
  // straight to the origin (first production run, 2026-10-11: every query "doesn't run"). The MCP Worker has it too.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "production",
    "OPENALEX_API_BASE": "https://api.openalex.org"
  }
}
